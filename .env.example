# Copy to .env and fill in. .env is gitignored — keep it that way.

# Alation instance, no trailing slash
ALATION_BASE_URL=https://your-instance.alationcloud.com

# M2M OAuth client. A Server Admin must create this for you at
# /admin/auth/ -> OAuth Client Applications. You cannot self-serve it.
#
# IMPORTANT: use a client dedicated to YOU. Minting a new access token
# invalidates the previous one, so a shared client means you and a colleague
# (or you and your own browser session) will knock each other out.
ALATION_CLIENT_ID=
ALATION_CLIENT_SECRET=

# Optional: legacy API token. Needed for the CDE service (Token header) and
# some /integration/v1 endpoints. Not needed for Agent Studio.
ALATION_ACCESS_TOKEN=

# Token cache location. Set to "none" to disable caching (not recommended —
# see the invalidation note above).
AGENTKIT_TOKEN_CACHE=~/.alation/agent-kit-tokens.json

# Set true only if you must talk to an instance with a bad cert.
SKIP_SSL_VERIFY=false

# --- Local prompt iteration (optional) ---
# Used by scripts that iterate against a raw model API before deploying to
# Agent Studio. Not required for deploy/invoke.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

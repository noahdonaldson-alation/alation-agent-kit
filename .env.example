# Copy to .env and fill in. .env is gitignored — keep it that way.

# Alation instance, no trailing slash
ALATION_BASE_URL=https://your-instance.alationcloud.com

# M2M OAuth client. A Server Admin must create this for you at
# /admin/auth/ -> OAuth Client Applications. You cannot self-serve it.
#
# IMPORTANT: use a client dedicated to YOU. Minting a new access token
# invalidates the previous one, so a shared client means you and a colleague
# (or you and your own browser session) will knock each other out.
ALATION_CLIENT_ID=
ALATION_CLIENT_SECRET=

# --- Legacy API token: needed ONLY for the CDE service ---
# The catalog APIs (/integration/v1/...) accept the OAuth bearer above, so you
# do not need anything here for policies. The CDE service (/cde-service/, used
# for CDE overlay standards) does not — it bootstraps a CDEToken from a legacy
# API access token.
#
# Preferred: give the kit a long-lived refresh token and your numeric user id,
# and it mints + caches short-lived access tokens for you.
#
#   Alation UI -> your avatar -> Account Settings -> Authentication
#     -> Create Refresh Token
#
# The same screen shows your user id; it is also returned by
# POST /integration/v1/createRefreshToken/ if you are not an SSO user.
ALATION_REFRESH_TOKEN=
# NUMERIC user id (e.g. 42). Not the token, not a UUID, and don't guess "1" —
# a wrong id mints a token for the wrong user. It is returned as `user_id` by
# createRefreshToken, and appears in the URL of your own profile page.
ALATION_USER_ID=

# Send the legacy TOKEN header on /integration/ calls too. Leave this OFF
# unless your instance cannot issue OAuth clients (OAuth is Cloud-only). A
# TOKEN header OVERRIDES the bearer, so switching this on with a wrong user id
# turns working catalog calls into 403s.
ALATION_FORCE_CATALOG_TOKEN=false

# Alternative: paste a short-lived API access token directly. It wins over the
# refresh token above, but expires in ~24h, so it is for one-offs only.
ALATION_ACCESS_TOKEN=

# Token cache location. Set to "none" to disable caching (not recommended —
# see the invalidation note above).
AGENTKIT_TOKEN_CACHE=~/.alation/agent-kit-tokens.json

# Set true only if you must talk to an instance with a bad cert.
SKIP_SSL_VERIFY=false

# --- Local prompt iteration (optional) ---
# Used by scripts that iterate against a raw model API before deploying to
# Agent Studio. Not required for deploy/invoke.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

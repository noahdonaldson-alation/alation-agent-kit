# Secrets — never commit
.env
*.pem
*.key

# Token cache (also lives in ~/.alation by default, but just in case)
.token_cache.json

# Deployment state records what we created in a CUSTOMER's catalog, by id.
# Instance-specific and not shareable — but never delete it while a deployment
# is live, or teardown loses track of what it made.
.deployment-state*.json

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# IDE
.idea/
.vscode/

# Extracted source text and generated output — regenerate, don't commit.
# If you later decide a specific artifact IS a deliverable, un-ignore it
# explicitly with another ! line rather than loosening this rule.
artifacts/*
!artifacts/.gitkeep

# OS
.DS_Store

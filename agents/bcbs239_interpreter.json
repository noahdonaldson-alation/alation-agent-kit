{
  "description": "Reads one BCBS 239 principle (passed as text) and proposes the Alation governance objects that would demonstrate compliance, with paragraph-level citations and honest scope classification.",
  "input_json_schema": {
    "properties": {
      "message": {
        "description": "Verbatim text of a single BCBS 239 principle, produced by scripts/extract_bcbs239.py. One principle per run — the full document risks a 413.",
        "type": "string"
      }
    },
    "required": [
      "message"
    ],
    "type": "object"
  },
  "llm": {
    "model_name": "claude-sonnet-4-6",
    "provider": "anthropic"
  },
  "mode": "tool_call",
  "name": "bcbs239_interpreter",
  "output_json_schema": {
    "$comment": "Mirrors schemas/policy_proposal.schema.json. Keep the two in sync; that file is the one evals validate against.",
    "properties": {
      "addressability_rationale": { "type": "string" },
      "audience": { "enum": ["bank", "supervisor"], "type": "string" },
      "catalog_addressability": {
        "enum": ["direct", "evidence_only", "out_of_scope"],
        "type": "string"
      },
      "citation": {
        "properties": {
          "paragraphs": { "items": { "type": "integer" }, "type": "array" },
          "quote": { "maxLength": 300, "type": "string" }
        },
        "required": ["paragraphs", "quote"],
        "type": "object"
      },
      "confidence": { "maximum": 1, "minimum": 0, "type": "number" },
      "principle_id": { "type": "string" },
      "principle_name": { "type": "string" },
      "principle_number": { "type": "integer" },
      "proposed_objects": {
        "items": {
          "properties": {
            "creation_mode": { "enum": ["rest", "cde_service", "ui"], "type": "string" },
            "depends_on": { "items": { "type": "string" }, "type": "array" },
            "endpoint": { "type": "string" },
            "kind": { "type": "string" },
            "payload": { "type": "object" },
            "ref": { "type": "string" }
          },
          "required": ["ref", "kind", "creation_mode", "payload"],
          "type": "object"
        },
        "type": "array"
      },
      "section": { "type": "object" },
      "unaddressed_by_catalog": { "items": { "type": "string" }, "type": "array" }
    },
    "required": [
      "principle_id",
      "principle_number",
      "principle_name",
      "audience",
      "citation",
      "catalog_addressability",
      "addressability_rationale",
      "proposed_objects"
    ],
    "type": "object"
  },
  "parameter_bindings": [],
  "prompt": "PLACEHOLDER — populated at deploy time from prompts/bcbs239_principle_extract.md via `agentkit deploy agents/bcbs239_interpreter.json --prompt bcbs239_principle_extract`. Do not edit this field by hand; the prompt file is the source of truth.",
  "published_status": "draft",
  "skill_names": [],
  "tags": [
    "bcbs239",
    "governance",
    "agent-kit"
  ],
  "tools": []
}

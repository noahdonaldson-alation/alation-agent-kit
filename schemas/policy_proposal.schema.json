{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BCBS 239 principle -> Alation object proposal",
  "type": "object",
  "required": [
    "principle_id",
    "principle_number",
    "principle_name",
    "audience",
    "citation",
    "catalog_addressability",
    "addressability_rationale",
    "proposed_objects"
  ],
  "additionalProperties": false,
  "properties": {
    "principle_id": { "type": "string", "pattern": "^BCBS239-P([1-9]|1[0-4])$" },
    "principle_number": { "type": "integer", "minimum": 1, "maximum": 14 },
    "principle_name": { "type": "string", "minLength": 3 },
    "section": {
      "type": "object",
      "required": ["number", "title"],
      "properties": {
        "number": { "type": "string", "enum": ["I", "II", "III", "IV"] },
        "title": { "type": "string" }
      }
    },
    "audience": { "type": "string", "enum": ["bank", "supervisor"] },
    "citation": {
      "type": "object",
      "required": ["paragraphs", "quote"],
      "properties": {
        "paragraphs": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 89 },
          "minItems": 1,
          "maxItems": 2
        },
        "quote": { "type": "string", "minLength": 10, "maxLength": 300 }
      }
    },
    "catalog_addressability": {
      "type": "string",
      "enum": ["direct", "evidence_only", "out_of_scope"]
    },
    "addressability_rationale": { "type": "string", "minLength": 10 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "proposed_objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "kind", "creation_mode", "payload"],
        "additionalProperties": false,
        "properties": {
          "ref": { "type": "string", "minLength": 3 },
          "kind": {
            "type": "string",
            "enum": [
              "policy",
              "cde_overlay_standard",
              "cde",
              "dq_monitor",
              "glossary_term",
              "document",
              "domain"
            ]
          },
          "creation_mode": {
            "type": "string",
            "enum": ["rest", "cde_service", "ui"],
            "description": "rest = documented public API; cde_service = undocumented /cde-service/integration/ endpoints; ui = manual"
          },
          "endpoint": { "type": "string" },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "payload": { "type": "object" }
        }
      }
    },
    "unaddressed_by_catalog": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "audience": { "const": "supervisor" } } },
      "then": {
        "properties": {
          "catalog_addressability": { "const": "out_of_scope" },
          "proposed_objects": { "maxItems": 0 }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alation.example/schemas/policy_spec.schema.json",
  "title": "Policy spec",
  "description": "The contract for a provisionable policy spec. Derived from policies/bcbs239.json, which is VERIFIED — it created 4 policies and 4 published overlay standards on finance-industry.mtse. Field names here match the CDE service's StandardCreationRequest exactly (note allowed_values, not accepted_values). Both the hand-authored spec and the policy_author agent's output validate against this, so `policy apply` cannot tell them apart.",
  "type": "object",
  "required": ["regulation", "policy_group", "policies", "standards"],
  "additionalProperties": false,
  "properties": {
    "$comment": {"type": "string"},
    "generated": {
      "type": "object",
      "description": "Present only on agent-authored specs. Its presence is what makes a generated spec distinguishable from a reviewed one, so `policy apply` can refuse to provision an unreviewed spec.",
      "required": ["by", "register_sha", "reviewed"],
      "properties": {
        "by": {"type": "string"},
        "at": {"type": "string"},
        "register_sha": {"type": "string"},
        "prompt_sha": {"type": "string"},
        "reviewed": {
          "type": "boolean",
          "description": "Set true BY A HUMAN after reading the spec. The kit never sets this."
        },
        "reviewed_by": {"type": "string"}
      }
    },
    "regulation": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "publisher": {"type": "string"},
        "published": {"type": "string"},
        "source_url": {"type": "string"}
      }
    },
    "policy_group": {
      "type": "object",
      "description": "A PREREQUISITE. Policy groups have no create API, so this is resolved by title and never created.",
      "required": ["ref", "title"],
      "properties": {
        "ref": {"type": "string"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "$comment": {"type": "string"}
      }
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref", "title", "derived_from", "description"],
        "additionalProperties": false,
        "properties": {
          "ref": {"type": "string", "pattern": "^POL-[A-Z0-9_]+$"},
          "title": {"type": "string", "minLength": 8},
          "derived_from": {
            "type": "object",
            "required": ["principle", "paragraphs"],
            "properties": {
              "principle": {
                "type": "integer", "minimum": 1, "maximum": 11,
                "description": "Bank-facing principles only. 12-14 address supervisors and are out of scope."
              },
              "paragraphs": {
                "type": "array", "minItems": 1,
                "items": {"type": "integer", "minimum": 1}
              }
            }
          },
          "description": {
            "type": "string", "minLength": 200,
            "description": "HTML. Must contain at least one verbatim quotation from the regulation with its paragraph reference — a policy that only paraphrases cannot be audited back to the source."
          },
          "template_id": {"type": "integer"},
          "fields": {"type": "array"}
        }
      }
    },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref", "from_policy", "purpose", "scope", "derived_requirements"],
        "additionalProperties": false,
        "properties": {
          "ref": {"type": "string", "pattern": "^STD-[A-Z0-9_]+$"},
          "from_policy": {
            "type": "string",
            "description": "Must match a policies[].ref. A Template Overlay standard derives from exactly one policy."
          },
          "purpose": {"type": "string", "minLength": 80},
          "scope": {"type": "string", "minLength": 30},
          "derived_requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "fields"],
              "additionalProperties": false,
              "properties": {
                "name": {"type": "string"},
                "description": {"type": "string"},
                "fields": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["name", "type"],
                    "additionalProperties": false,
                    "properties": {
                      "name": {"type": "string"},
                      "type": {
                        "type": "string",
                        "enum": ["picker", "text"],
                        "description": "The CDE OpenAPI spec types this as a nullable string with NO enum. 'picker' is confirmed by Alation's own example; 'text' is confirmed only by our successful creates on finance-industry.mtse. Restricted here to the two we have actually landed — widen it only after `policy standards` shows another value in a real object."
                      },
                      "allowed_values": {
                        "type": "array",
                        "items": {"type": "string"},
                        "description": "Required for type picker. NOT 'accepted_values' — that invented name caused a 400."
                      },
                      "referenced_object_type": {"type": "string"}
                    },
                    "allOf": [
                      {
                        "if": {"properties": {"type": {"const": "picker"}}, "required": ["type"]},
                        "then": {"required": ["allowed_values"]}
                      },
                      {
                        "if": {"properties": {"type": {"const": "text"}}, "required": ["type"]},
                        "then": {
                          "not": {"required": ["allowed_values"]},
                          "description": "A free-text field with a fixed value list is a contradiction — make it a picker."
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "standard_attachment": {
      "type": "object",
      "description": "Which standards attach to a CDE, DERIVED from the principles in that CDE's driven_by. Neither pipeline agent needs to know policies exist.",
      "properties": {
        "$comment": {"type": "string"},
        "by_principle": {
          "type": "object",
          "patternProperties": {
            "^(1[01]|[1-9])$": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        }
      }
    }
  }
}
